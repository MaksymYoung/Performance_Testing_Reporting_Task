              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="Origin" elementType="Header">
                    <stringProp name="Header.name">Origin</stringProp>
                    <stringProp name="Header.value">${base_url}</stringProp>
                  </elementProp>
                  <elementProp name="Referer" elementType="Header">
                    <stringProp name="Header.name">Referer</stringProp>
                    <stringProp name="Header.value">${base_url}/checkout</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert Order Placed (Thank You page)" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="1905034515">&lt;title&gt;Thank You &amp;#8211; Performance testing Essentials&lt;/title&gt;</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">Order was not placed: Thank You page was not returned after redirect</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
