      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Median performance score",
          "description": "0-100. Navigation steps only. Good >= 90, poor < 50.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "dg38eayfgj2m8a"
                      },
                      "spec": {
                        "query": "data = from(bucket: \"lighthouse\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"lighthouse\" and r._field == \"performance_score\")\n  |> filter(fn: (r) => r.scenario == \"${scenario}\")\n  |> filter(fn: (r) => contains(value: r.step, set: ${step:json}))\n  |> group(columns: [\"step\"])\n\nmed = data |> median(method: \"exact_mean\") |> keep(columns: [\"step\", \"_value\"]) |> set(key: \"stat\", value: \"median\")\navg = data |> mean()                       |> keep(columns: [\"step\", \"_value\"]) |> set(key: \"stat\", value: \"mean\")\nmn  = data |> min()                        |> keep(columns: [\"step\", \"_value\"]) |> set(key: \"stat\", value: \"min\")\nmx  = data |> max()                        |> keep(columns: [\"step\", \"_value\"]) |> set(key: \"stat\", value: \"max\")\n\nunion(tables: [med, avg, mn, mx])\n  |> group()\n  |> pivot(rowKey: [\"step\"], columnKey: [\"stat\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({r with _time: v.timeRangeStop}))"
                      }
