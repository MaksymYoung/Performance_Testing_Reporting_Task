      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Summary over the selected time range (all runs)",
          "description": "Median / mean / min / max / sample std dev of every metric per step over ALL runs in the selected time range - the same statistics as performance-testing-essentials.summary.html. Set the time range to cover exactly your 10 loops. ms for FCP/LCP/Speed Index/TBT/TTI, unitless for CLS, 0-100 for performance_score. Timespan steps have no FCP/LCP/Speed Index/TTI.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "dg38eayfgj2m8a"
                      },
                      "spec": {
                        "query": "import \"math\"\n\ndata = from(bucket: \"lighthouse\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"lighthouse\")\n  |> filter(fn: (r) => r.scenario == \"${scenario}\")\n  |> filter(fn: (r) => contains(value: r.step, set: ${step:json}))\n  |> group(columns: [\"step\", \"_field\"])\n\nwithStat = (stat, tables=<-) => tables\n  |> map(fn: (r) => ({step: r.step, _field: r._field, stat: stat, _value: if exists r._value then float(v: r._value) else 0.0}))\n\nunion(tables: [\n  data |> count() |> withStat(stat: \"runs\"),\n  data |> median(method: \"exact_mean\") |> withStat(stat: \"median\"),\n  data |> mean() |> withStat(stat: \"mean\"),\n  data |> min() |> withStat(stat: \"min\"),\n  data |> max() |> withStat(stat: \"max\"),\n  data |> stddev() |> withStat(stat: \"std_dev\"),\n])\n  |> group()\n  |> map(fn: (r) => ({r with _value: if r._field == \"cls\" then math.round(x: r._value * 1000.0) / 1000.0 else math.round(x: r._value)}))\n  |> pivot(rowKey: [\"step\", \"_field\"], columnKey: [\"stat\"], valueColumn: \"_value\")\n  |> rename(columns: {_field: \"metric\", runs: \"Runs\", median: \"Median\", mean: \"Mean\", min: \"Min\", max: \"Max\", std_dev: \"Std dev\"})\n  |> sort(columns: [\"step\", \"metric\"])"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
