      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "${metric} by loop",
          "description": "The metric chosen in the 'Metric (by-loop chart)' variable, one group of bars per loop (1..N), one bar per step. Uses the 'loop' tag written by lighthouse-influx.js (RUN_INDEX); data from older runs without the tag is shown as 'n/a'. If the same loop number appears twice in the time range (a rerun), the latest value is used.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "dg38eayfgj2m8a"
                      },
                      "spec": {
                        "query": "import \"math\"\n\nfrom(bucket: \"lighthouse\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"lighthouse\" and r._field == \"${metric}\")\n  |> filter(fn: (r) => r.scenario == \"${scenario}\")\n  |> filter(fn: (r) => contains(value: r.step, set: ${step:json}))\n  |> group(columns: [\"step\", \"loop\"])\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({r with\n      loop: if exists r.loop then (if int(v: r.loop) < 10 then \"0\" + r.loop else r.loop) else \"n/a\",\n      _value: math.round(x: r._value)\n  }))\n  |> keep(columns: [\"loop\", \"step\", \"_value\"])\n  |> pivot(rowKey: [\"loop\"], columnKey: [\"step\"], valueColumn: \"_value\")\n  |> rename(fn: (column) => if column == \"loop\" then column else column + \", ms\")\n  |> sort(columns: [\"loop\"])"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
